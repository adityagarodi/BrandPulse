# Twitter / X API v2 Bearer Token (optional for sample and CSV modes)
TWITTER_BEARER_TOKEN=

# Allowed Frontend URLs for CORS (comma-separated)
# e.g. https://brandpulse.vercel.app,http://127.0.0.1:5500,http://localhost:5500
FRONTEND_URL=http://127.0.0.1:5500,http://localhost:5500

# Server Port (Render sets this dynamically)
PORT=5000
FLASK_ENV=production
