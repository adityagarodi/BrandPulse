# Twitter / X API v2 Credentials
# Get your Bearer Token and API keys from https://developer.twitter.com/
TWITTER_BEARER_TOKEN=your_bearer_token_here
TWITTER_API_KEY=your_api_key_here
TWITTER_API_SECRET=your_api_secret_here
TWITTER_ACCESS_TOKEN=your_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_access_token_secret_here

# Flask Configuration
FLASK_ENV=development
SECRET_KEY=brandpulse-secret-key-change-in-production-2026
DATABASE_URI=sqlite:///brandpulse.db

# Brand Health Alert Threshold (Default percentage of negative tweets triggering alert, e.g. 40)
DEFAULT_ALERT_THRESHOLD=40
